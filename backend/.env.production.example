# SubscriptNova Backend Production Environment Template
# Copy to .env in production: cp .env.production.example .env

PROJECT_NAME="SubscriptNova"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistent Database Storage (SQLite with PRAGMA foreign_keys=ON)
DATABASE_URL="sqlite:////app/data/subscriptnova.db"

# Allowed CORS Origins (Comma-separated full origin URLs)
CORS_ORIGINS="https://yourdomain.com,http://localhost"
